/* MDB BRABO — dark theme (MongoDB green accent on GitHub-dark) */
Screen { background: #0d1117; color: #e6edf3; }
Header { background: #1c2128; color: #00ed64; text-style: bold; }
Footer { background: #1c2128; }
#main-vertical { height: 1fr; width: 1fr; }
Tabs { background: #161b22; height: 3; }
Tab { color: #8b949e; padding: 0 2; }
Tab.-active { color: #00ed64; text-style: bold; }
ContentSwitcher { height: 1fr; width: 1fr; }
.hidden { display: none; }
DataTable { background: #161b22; color: #e6edf3; }
DataTable > .datatable--header { background: #1c2128; color: #00ed64; text-style: bold; }
DataTable > .datatable--cursor { background: #023430; color: #ffffff; }
Input { background: #161b22; border: tall #2d4a3e; }
